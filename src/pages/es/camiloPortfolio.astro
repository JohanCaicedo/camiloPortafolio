const EXPERIENCE_DATA = [
  {
    date: "Ago. 2020 – Presente · 5 años 2 meses",
    title: "Diseñador Generalista",
    company:
      "Instituto Latinoamericano para una Sociedad y un Derecho Alternativos - ILSA",
    description:
      "Como diseñador generalista de ILSA, me especializo en diseño web, diseño editorial, ilustración, branding, fotografía y producción audiovisual. He creado y mantenido con éxito una identidad visual cohesiva, armoniosa y distintiva para el instituto, mejorando significativamente su presencia en el mercado. Además, he liderado proyectos clave que han contribuido al crecimiento y éxito de la organización.",
  },
  {
    date: "Ene 2025 – Sep 2025 · 8 meses",
    title: "Diseñador Gráfico",
    company: "PIPE TORO SAS",
    description:
      "Desarrollé soluciones visuales estratégicas para marcas como Reprotec, Fogafín y Puffer, integrando diseño web, branding y comunicación gráfica. Logros clave incluyen liderar el rediseño del sitio web para Reprotec, enfocado en la experiencia del usuario y la coherencia de la marca, junto con la creación de materiales corporativos impactantes y campañas que fortalecieron la identidad visual de cada cliente.",
  },
  {
    date: "May 2023 – Jul. 2023 · 3 meses",
    title: "Desarrollador Web y Diseño",

  },
  {
    date: "Jul. 2022 – Oct. 2022 · 4 meses",
    title: "Desarrollador Web y Diseño",
    company:
      "Instituto Latinoamericano para una Sociedad y un Derecho Alternativos - ILSA",
    description:
      "Encabecé el rediseño completo del sitio web principal del instituto, estableciendo una identidad visual corporativa robusta y estratégica. Implementamos canales de comunicación efectivos con los usuarios, consolidamos el archivo institucional y definimos la estética de la plataforma digital. Este proyecto transformador elevó la relevancia de la compañía en la industria, pasando de una presencia en línea limitada a una plataforma con 15,000 visitantes únicos por mes. Además, mejoramos significativamente el SEO y el rendimiento del sitio, asegurando una experiencia de usuario óptima.",
  },
  {
    date: "Jul. 2022 – Oct. 2022 · 4 meses",
    title: "Fotógrafo y Videógrafo",
    company: "Renta Fácil",
    description:
      "Servicios de producción individual, incluyendo videos para redes sociales, videos corporativos y sesiones de fotografía corporativa.",
    link: "#",
  },
  {
    date: "Jul. 2020 – Nov. 2020 · 5 meses",
    title: "Diseñador digital y fotógrafo",
    company: "Aire libre y aventura",
    description:
      "Fui parte del equipo de Kuerfit, sirviendo como editor de video, diseñador gráfico y fotógrafo. Encabecé la producción del curso en video 'Entrenamiento de Fuerza', creé videos promocionales y volantes para redes sociales y el sitio web, y proporcioné cobertura fotográfica del evento 'Corre Chicaque'.",
  },
];
---

<Layout
  title="Johan Caicedo - Portafolio de Diseñador Digital y Multimedia"
  description="Explora el portafolio de Johan Caicedo, un Diseñador Digital y Multimedia con más de 5 años de experiencia en diseño web, diseño gráfico y animación. Basado en Bogotá, Colombia."
  image="https://firebasestorage.googleapis.com/v0/b/camilo-portfolio-77b8a.appspot.com/o/Zorrito.png?alt=media&token=35a1b571-7ed0-45be-852d-542823d05bbb"
  url="https://paperfoxstudio.site/"
  canonicalURL="https://paperfoxstudio.site/"
>
  <main>
    <SectionContainer class="hidden sm:block md:block">
      <Spline client:load />
    </SectionContainer>
    <h1
      class="text-4xl md:text-5xl font-bold text-primary mb-4 flex flex-col text-center md:text-left md:flex-row flex-wrap justify-center items-center gap-4 dark:text-[#fafaf6] mt-10"
    >
      Hola, soy Johan Caicedo
      <a
        href="https://www.linkedin.com/in/johan-caicedo/"
        target="_blank"
        rel="noopener"
        class="flex justify-center items-center dark:text-[#fafaf6]"
      >
        <Badge
          content="Disponible para trabajar"
          bgColor="bg-gradient-to-l from-blue-600 to-purple-500"
          textColor="text-[#fafaf6]"
          darkBgColor="dark:bg-gradient-to-l dark:from-blue-900 dark:to-purple-900"
          darkTextColor="text-[#fafaf6]"
        />
      </a>
    </h1>

    <h2
      class="text-3xl md:text-2xl sm:text-base mb-4 dark:text-[#fafaf6] text-center"
    >
      Diseñador digital y multimedia con más de 5 años de experiencia
      profesional.
      <br />
      <span class="text-2xl text-secondary">
        Diseño con <strong
          class="font-semibold text-sky-500 hover:font-black hover:text-sky-800 dark:hover:text-sky-100 transition-all duration-300"
          >alma</strong
        >, desarrollo con <strong
          class="font-semibold text-emerald-600 dark:text-emerald-200 hover:font-mono hover:font-black hover:text-emerald-800 transition-all duration-3000"
          >lógica</strong
        >, animación con <strong
          class="font-semibold text-red-500 hover:font-bold hover:text-red-800 dark:hover:text-red-100 hover:tracking-widest transition-all duration-300"
          >pasión</strong
        >.
      </span>
      <br />
      <span class="text-sm">De Bogotá DC, Colombia.</span>
    </h2>

    <nav class="flex flex-wrap justify-center gap-2 mt-4">
      <SocialPills
        href="https://www.linkedin.com/in/johan-caicedo/"
        client:load
      >
        <LinkedIn class="size-6 mr-1" /> LinkedIn
      </SocialPills>

      <SocialPills href="mailto:camilo.design07@gmail.com" client:load>
        <MailIcon class="size-6 mr-1" /> Mail
      </SocialPills>

      <SocialPills href="https://github.com/JohanCaicedo" client:load>
        <GithubIcon class="size-6 mr-1" /> Github
      </SocialPills>

      <SocialPills href="tel:+573003094625" client:load>
        <WhatsappIcon class="size-6 mr-1" /> Teléfono
      </SocialPills>
    </nav>

    <SectionContainer id="projects">
      <section>
        <h3
          class="flex gap-2 items-center text-2xl md:text-3xl font-bold text-primary mb-6 mt-6 dark:text-[#fafaf6]"
        >
          <Bifcase class="size-6" /> Proyectos Seleccionados
        </h3>
        <Areas client:load areas={areas} />
      </section>
    </SectionContainer>

    <SectionContainer id="experience">
      <h3
        class="flex gap-2 items-center text-2xl md:text-3xl font-bold text-primary mb-6 mt-6 dark:text-[#fafaf6]"
      >
        <Arrow class="size-6" /> Experiencia Profesional
      </h3>
      <Experience experience={EXPERIENCE_DATA} />
    </SectionContainer>

    <SectionContainer id="education">
      <section>
        <h3
          class="flex gap-2 items-center text-2xl md:text-3xl font-bold text-primary mb-6 mt-6 dark:text-[#fafaf6]"
        >
          <Certificate class="size-6" /> Educación
        </h3>
        <Card />
      </section>

      <DesignTools />
    </SectionContainer>
  </main>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "mainEntity": {
        "@type": "Person",
        "name": "Johan Caicedo",
        "jobTitle": "Digital and Multimedia Designer",
        "url": "https://paperfoxstudio.site/",
        "image": "https://firebasestorage.googleapis.com/v0/b/camilo-portfolio-77b8a.appspot.com/o/Zorrito.png?alt=media&token=35a1b571-7ed0-45be-852d-542823d05bbb",
        "sameAs": [
          "https://www.linkedin.com/in/johan-caicedo/",
          "https://github.com/JohanCaicedo"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Bogotá",
          "addressCountry": "CO"
        }
      }
    }
  </script>
</Layout>

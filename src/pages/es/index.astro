---
import LayoutStudio from "../../layouts/LayoutStudio.astro";
import ButtonPortfolio from "../../components/Button.astro";
import SectionContainer from "../../components/SectionContainer.astro";

const pageTitle = "Paper Fox Studio";
const pageDescription = "Sitio web de Paper Fox Studio";
const pageUrl = "https://paperfoxstudio.site/";
const pageImage =
  "https://firebasestorage.googleapis.com/v0/b/camilo-portfolio-77b8a.appspot.com/o/Zorrito.png?alt=media&token=a8a6bfa8-fc10-41bf-8495-f9b7c4700749";
---

<LayoutStudio
  title={pageTitle}
  description={pageDescription}
  url={pageUrl}
  image={pageImage}
>
  <main>
    <SectionContainer class="w-full lg:w-[740px] mx-auto py-44">
      <section class="flex flex-col items-center">
        <h1 class="text-wihite text-5xl font-bold flex flex-row gap-x-4 pb-4">
          Sitio web de Paper Fox Studio
        </h1>
        <h4 class="text-wihite text-3xl font-bold flex flex-row gap-x-4 pb-4">
          Está bajo construcción
        </h4>
        <p>Estamos trabajando para estar en línea lo antes posible</p>
        <div class="mt-10">
          <a href="/es/camiloPortfolio">
            <ButtonPortfolio label="Portafolio de Johan Caicedo" />
          </a>
        </div>
      </section>
    </SectionContainer>
  </main>
</LayoutStudio>

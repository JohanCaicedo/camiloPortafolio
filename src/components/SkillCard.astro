---

import { Image } from "astro:assets";
import LiquidGlassCard from '../components/LiquidGlass.jsx';

const { title, imageSrc, imageAlt, experienceLevel, titleClass, experienceClass } = Astro.props;
---

<LiquidGlassCard 
  client:visible
  className="p-4 flex flex-col items-center justify-center flex-shrink-0 w-36 md:w-auto dark:text-[#fafaf6]"
  glassColor="rgba(149, 172, 202, 0.25)" 
  darkGlassColor="rgba(34, 40, 46, 0.25)"
  glassBgClass=""
>
<h5 class=`font-bold leading-tight text-sm text-center mb-2 ${titleClass}`>{title}</h5>
  
  <div class="w-[80px] h-[80px] flex items-center justify-center">
    {Astro.slots.has('icon')? (
      <slot name="icon" />
    ) : (
      <Image
        src={imageSrc}
        alt={imageAlt?? title}
        width="80"
        height="80"
      />
    )}
  </div>
  
  <h6 class="font-semibold mt-2 text-xs">Experience</h6>
  <p class={`text-xs ${experienceClass}`}>{experienceLevel}</p>
</LiquidGlassCard>
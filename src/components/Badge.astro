---
const { content, bgColor, textColor, darkBgColor, darkTextColor } = Astro.props;

const badgeClasses = [
  "text-sm",
  "text-center",
  "font-semibold",
  "p-2",
  "rounded-full",
  bgColor,
  textColor,
  darkBgColor,
  darkTextColor,
  "items-center",
  "m-auto",
].join(" ");
---

<span class={badgeClasses}>
  {content}
</span>


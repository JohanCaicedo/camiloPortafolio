---
import Home from "../icons/Home.astro";
---

<nav class="shadow-mb relative z-10">
    {/* Contenedor principal con padding responsivo */}
    <div class="bg-[#fffdf3] dark:bg-[#111827] max-w-screen-xl flex items-center justify-between mx-auto px-4 md:pl-24 md:pr-24 py-3 rounded-lg shadow-sm">
        
        <div class="hidden md:flex md:order-1" id="navbar-desktop-links">
            <ul class="flex items-center font-medium space-x-8 rtl:space-x-reverse flex-row bg-transparent">
                <li>
                    <a href="/camiloPortfolio/" class="block py-2 px-3 text-gray-900 rounded hover:bg-transparent hover:text-blue-700 p-0 dark:text-white md:dark:hover:text-blue-500 dark:hover:text-white md:dark:hover:bg-transparent">
                        <Home/>
                    </a>
                </li>
                <li>
                    <a href="/camiloPortfolio/#about" class="block py-2 px-3 text-gray-900 rounded hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-700 md:p-0 dark:text-white md:dark:hover:text-blue-500 dark:hover:bg-gray-700 dark:hover:text-white md:dark:hover:bg-transparent">About</a>
                </li>
                <li>
                    <a href="/camiloPortfolio/#projects" class="block py-2 px-3 text-gray-900 rounded hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-700 md:p-0 dark:text-white md:dark:hover:text-blue-500 dark:hover:bg-gray-700 dark:hover:text-white md:dark:hover:bg-transparent">Projects</a>
                </li>
                <li>
                    <a href="/camiloPortfolio/#education" class="block py-2 px-3 text-gray-900 rounded hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-700 md:p-0 dark:text-white md:dark:hover:text-blue-500 dark:hover:bg-gray-700 dark:hover:text-white md:dark:hover:bg-transparent">Education</a>
                </li>
                <li>
                    <a href="/camiloPortfolio/#experience" class="block py-2 px-3 text-gray-900 rounded hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-700 md:p-0 dark:text-white md:dark:hover:text-blue-500 dark:hover:bg-gray-700 dark:hover:text-white md:dark:hover:bg-transparent">Experience</a>
                </li>
            </ul>
        </div>
        
        <div class="hidden md:flex items-center md:order-2">
             <button type="button" class="group relative overflow-hidden w-16 h-16" id="user-menu-button-desktop" aria-expanded="false" data-dropdown-toggle="user-dropdown">
              <span class="sr-only">Open user menu</span>
              <img class="rounded-full w-full h-full object-cover opacity-100 transition-all duration-300 group-hover:opacity-0 group-hover:scale-110" src="/Profile-Foto-Camilo.webp" alt="Camilo Profile">
              <img class="rounded-full w-full h-full object-cover absolute top-0 left-0 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:scale-110" src="/Foxy-Blink-nav-bar.gif" alt="PaperFoxBlink">
            </button>
        </div>


        <div class="md:hidden">
            <a href="/camiloPortfolio/">
                <div class="group relative overflow-hidden w-16 h-16">
                    <img class="rounded-full w-full h-full object-cover opacity-100 transition-all duration-300 group-hover:opacity-0 group-hover:scale-110" src="/Profile-Foto-Camilo.webp" alt="Camilo Profile">
                    <img class="rounded-full w-full h-full object-cover absolute top-0 left-0 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:scale-110" src="/Foxy-Blink-nav-bar.gif" alt="PaperFoxBlink">
                </div>
            </a>
        </div>

        <div class="md:hidden">
            <span class="text-lg font-bold text-[#1d1735] dark:text-[#fafaf6] md:hidden">
              Portfolio
            </span>
        </div>

        <div class="md:hidden">
             <button id="menu-button" class="block md:hidden inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600" aria-controls="navbar-mobile-links" aria-expanded="false">
                <span class="sr-only">Open main menu</span>
                <svg class="w-8 h-8 text-gray-800 dark:text-[#fafaf6]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
                </svg>
            </button>
        </div>
    </div>

    <div class="z-50 hidden my-4 text-base list-none bg-white divide-y divide-gray-100 rounded-lg shadow dark:bg-gray-700 dark:divide-gray-600" id="user-dropdown">
        <div class="px-4 py-3">
            <span class="block text-sm font-semibold text-gray-900 dark:text-white">Johan Camilo Caicedo</span>
            <span class="block text-sm text-gray-500 truncate dark:text-gray-400">camilo.design07@gmail.com</span>
            <span class="block text-sm text-gray-500 truncate dark:text-gray-400">+57 300 3094625</span>
        </div>
        <ul class="py-2" aria-labelledby="user-menu-button-desktop">
            <li>
                <a href="/cv" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 dark:text-gray-200 dark:hover:text-white">Curriculum</a>
            </li>
        </ul>
    </div>

    <div class="hidden w-full md:hidden" id="navbar-mobile-links">
        <ul class="flex flex-col font-medium mt-4 rounded-lg bg-gray-50 dark:bg-gray-800 dark:border-gray-700">
            <li><a href="/camiloPortfolio/#about" class="block py-2 px-3 text-gray-900 rounded dark:text-white">About</a></li>
            <li><a href="/camiloPortfolio/#projects" class="block py-2 px-3 text-gray-900 rounded dark:text-white">Projects</a></li>
            <li><a href="/camiloPortfolio/#education" class="block py-2 px-3 text-gray-900 rounded dark:text-white">Education</a></li>
            <li><a href="/camiloPortfolio/#experience" class="block py-2 px-3 text-gray-900 rounded dark:text-white">Experience</a></li>
        </ul>
    </div>
</nav>

</div>
  
<script is:inline src="https://unpkg.com/flowbite@1.5.1/dist/flowbite.js"></script>
---
import ThemeToggle from "../components/ThemeToggle.jsx";
import { Image } from "astro:assets";
import Home from "../icons/Home.astro";


import profileImage from "../assets/Profile-Foto-Camilo.webp";
import foxGif from "../assets/Foxy-Blink-nav-bar.gif";
---

<div>
  <nav class="shadow-mb relative z-10">
    <div class="bg-[#fffdf3] dark:bg-[#111827] max-w-screen-xl flex items-center justify-between mx-auto px-4 md:px-8 lg:px-24 py-3 rounded-lg shadow-sm">

      {/* --- VISTA DE ESCRITORIO --- */}
      <div class="hidden md:flex md:order-1 items-center">
        <ul class="flex items-center font-medium space-x-8 rtl:space-x-reverse flex-row bg-transparent">
          <li>
            <a href="/camiloPortfolio/" aria-label="Home" class="block py-2 px-3 text-gray-900 rounded hover:bg-transparent hover:text-blue-700 p-0 dark:text-white md:dark:hover:text-blue-500">
              <Home />
            </a>
          </li>
          <li><a href="/camiloPortfolio/#about" class="block py-2 px-3 text-gray-900 rounded hover:bg-transparent md:hover:text-blue-700 md:p-0 dark:text-white">About</a></li>
          <li><a href="/camiloPortfolio/#projects" class="block py-2 px-3 text-gray-900 rounded hover:bg-transparent md:hover:text-blue-700 md:p-0 dark:text-white">Projects</a></li>
          <li><a href="/camiloPortfolio/#education" class="block py-2 px-3 text-gray-900 rounded hover:bg-transparent md:hover:text-blue-700 md:p-0 dark:text-white">Education</a></li>
          <li><a href="/camiloPortfolio/#experience" class="block py-2 px-3 text-gray-900 rounded hover:bg-transparent md:hover:text-blue-700 md:p-0 dark:text-white">Experience</a></li>
        </ul>
      </div>
      <div class="hidden md:flex items-center md:order-3 gap-x-4">
        <ThemeToggle client:load />
        <button type="button" class="group relative overflow-hidden w-16 h-16" id="user-menu-button-desktop" aria-expanded="false" data-dropdown-toggle="user-dropdown">
          <span class="sr-only">Open user menu</span>
        
          <Image 
            class="rounded-full w-full h-full object-cover opacity-100 transition-all duration-300 group-hover:opacity-0 group-hover:scale-110" 
            src={profileImage} 
            alt="Camilo Profile"
            width={128}
            height={128}
            loading="eager"
          />
          <Image 
            class="rounded-full w-full h-full object-cover absolute top-0 left-0 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:scale-110" 
            src={foxGif} 
            alt="PaperFoxBlink"
            width={128}
            height={128}
            loading="eager"
          />
        </button>
      </div>
      
      {/* --- VISTA MÓVIL --- */}
      <div class="md:hidden flex items-center justify-start">
        <button type="button" class="group relative overflow-hidden w-16 h-16" id="user-menu-button-mobile" aria-expanded="false" data-dropdown-toggle="user-dropdown">
          <span class="sr-only">Open user menu</span>
   
          <Image 
            class="rounded-full w-full h-full object-cover opacity-100 transition-all duration-300 group-hover:opacity-0 group-hover:scale-110" 
            src={profileImage} 
            alt="Camilo Profile"
            width={128}
            height={128}
            loading="eager"
          />
          <Image 
            class="rounded-full w-full h-full object-cover absolute top-0 left-0 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:scale-110" 
            src={foxGif} 
            alt="PaperFoxBlink"
            width={128}
            height={128}
            loading="eager"
          />
        </button>
      </div>
      <div class="md:hidden">
        <a href="/camiloPortfolio/" class="text-xl font-bold text-gray-900 dark:text-white">Portfolio</a>
      </div>
      <div class="md:hidden flex items-center justify-end">
        <button data-collapse-toggle="navbar-user-mobile" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600" aria-controls="navbar-user-mobile" aria-expanded="false">
          <span class="sr-only">Open main menu</span>
          <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
          </svg>
        </button>
      </div>
    </div>

    {/* --- MENÚS DESPLEGABLES --- */}
    <div class="z-50 hidden my-4 text-base list-none bg-white divide-y divide-gray-100 rounded-lg shadow dark:bg-gray-700 dark:divide-gray-600" id="user-dropdown">
      <div class="px-4 py-3">
        <span class="block text-sm font-semibold text-gray-900 dark:text-white">Johan Camilo Caicedo</span>
        <span class="block text-sm text-gray-500 truncate dark:text-gray-400">camilo.design07@gmail.com</span>
        <span class="block text-sm text-gray-500 truncate dark:text-gray-400">+57 350 3482505</span>
      </div>
      <ul class="py-2" aria-labelledby="user-menu-button">
        <li>
          <a href="/cv" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 dark:text-gray-200 dark:hover:text-white">Curriculum</a>
        </li>
      </ul>
    </div>
    
    <div class="hidden w-full md:hidden" id="navbar-user-mobile">
      <ul class="flex flex-col font-medium p-4 mt-4 border border-gray-100 rounded-lg bg-gray-50 dark:bg-gray-800 dark:border-gray-700">
        <li><a href="/camiloPortfolio/" class="block py-2 px-3 text-gray-900 rounded dark:text-white">Home</a></li>
        <li><a href="/camiloPortfolio/#about" class="block py-2 px-3 text-gray-900 rounded dark:text-white">About</a></li>
        <li><a href="/camiloPortfolio/#projects" class="block py-2 px-3 text-gray-900 rounded dark:text-white">Projects</a></li>
        <li><a href="/camiloPortfolio/#education" class="block py-2 px-3 text-gray-900 rounded dark:text-white">Education</a></li>
        <li><a href="/camiloPortfolio/#experience" class="block py-2 px-3 text-gray-900 rounded dark:text-white">Experience</a></li>
         <li>
          <ThemeToggle client:load/>
        </li> 
      </ul>
    </div>
  </nav>
</div>

<script is:inline src="https://unpkg.com/flowbite@1.5.1/dist/flowbite.js"></script>
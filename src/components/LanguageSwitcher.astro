---
// Simple language switcher - no complex logic that could cause freezing
const currentPath = Astro.url.pathname;
const isSpanish = currentPath.startsWith('/es');

// Determine the alternate language URL
let toggleUrl = currentPath;
if (isSpanish) {
  // Switch to English: remove /es prefix
  toggleUrl = currentPath.replace(/^\/es/, '') || '/camiloPortfolio';
} else {
  // Switch to Spanish: add /es prefix
  toggleUrl = '/es' + currentPath;
}
---

<a
  href={toggleUrl}
  class="language-switcher"
  aria-label={isSpanish ? "Switch to English" : "Cambiar a Español"}
  data-lang={isSpanish ? "en" : "es"}
>
  <span class="lang-option" data-active={!isSpanish}>EN</span>
  <span class="lang-divider">/</span>
  <span class="lang-option" data-active={isSpanish}>ES</span>
</a>

<script>
  // Save language preference when user manually switches
  document.querySelectorAll('.language-switcher').forEach(switcher => {
    switcher.addEventListener('click', (e) => {
      const targetLang = (e.currentTarget as HTMLAnchorElement).dataset.lang;
      if (targetLang) {
        localStorage.setItem('preferredLanguage', targetLang);
      }
    });
  });
</script>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: transparent;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .language-switcher:hover {
    background: rgba(59, 130, 246, 0.1);
    transform: translateY(-1px);
  }

  .lang-option {
    color: #9ca3af;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .lang-option[data-active="true"] {
    color: #3b82f6;
    transform: scale(1.1);
  }

  .lang-option[data-active="true"]::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6);
    border-radius: 2px;
    animation: slideIn 0.3s ease-out;
  }

  @keyframes slideIn {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  .lang-divider {
    color: #d1d5db;
    font-weight: 300;
  }

  /* Dark mode support */
  :global(.dark) .lang-option {
    color: #6b7280;
  }

  :global(.dark) .lang-option[data-active="true"] {
    color: #60a5fa;
  }

  :global(.dark) .language-switcher:hover {
    background: rgba(59, 130, 246, 0.15);
  }

  :global(.dark) .lang-divider {
    color: #4b5563;
  }
</style>
